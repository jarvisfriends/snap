*.exe
*.test
*.out

# Env and IDE
.env
.idea/
.history/
dist/

# The demo binary and the gifs the tapes render both land in dist/, which is
# already ignored above. The published gif URLs are recorded beside the tapes
# as examples/*.gif.url and ARE committed: dist/ does not survive a clone, and
# `goreleaser release --clean` wipes it.
examples/*/demo-bin
examples/*/*.exe

.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.env
.env.*
!.env.example
coverage/
coverage.out
.coverage
*.log
tmp/
.cache/
/vendor

