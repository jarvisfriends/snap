# Binaries
*.exe
*.test
*.out

# Env and IDE
.env
.idea/
.history/
dist/

# The demo binary and the gifs the tapes render both land in dist/, which is
# already ignored above. The gifs reach readers as release assets, attached by
# goreleaser — nothing about them is tracked in the repo. release.yml stages
# them in demo-gifs/ on the way there; that must stay ignored or goreleaser's
# dirty-tree check fails the release.
demo-gifs/
examples/*/demo-bin
examples/*/*.exe

.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.env
.env.*
!.env.example
coverage/
coverage.out
.coverage
*.log
tmp/
.cache/
/vendor

# Go local build/test artifacts
bin/
dist/
*.test
*.prof
*.pprof
/gitleaks.tgz

# Stray gifs anywhere outside dist/ are still build artifacts, never sources.
*.gif
